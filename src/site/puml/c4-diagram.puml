' @guidance:
' Create or update the C4 Component-level PlantUML diagram for the project.
'
' - If a C4 Component diagram already exists.
' - If no diagram exists, generate a new one that clearly represents all major components, their responsibilities, and interactions within the project.
' - Use PlantUML C4-PlantUML syntax and best practices for clarity and maintainability.
' - Include only relevant components from `/src/main/java` and external systems; remove or omit unnecessary details.
' - Organize the diagram for readability, avoiding complexity and clutter.
' - Add SHOW_LEGEND() at the end of the puml code.

@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_TOP_DOWN()
title Bindex Maven Plugin - Component Diagram

Person(developer, "Maven developer", "Invokes the plugin and supplies project configuration.")

System_Boundary(plugin, "Bindex Maven Plugin") {
  Component(bindexMojo, "BindexMojo", "Aggregator Maven Mojo", "Executes the bindex Act once for the Maven reactor and exposes shared workflow configuration.")
  Component(bindexPerModuleMojo, "BindexPerModuleMojo", "Per-module Maven Mojo", "Executes the bindex Act for each Maven module and exposes shared workflow configuration.")
  Component(registerMojo, "RegisterMojo", "Aggregator Maven Mojo", "Reuses the aggregator configuration and executes bindex/register once for the reactor.")
  Component(registerPerModuleMojo, "RegisterPerModuleMojo", "Per-module Maven Mojo", "Reuses the per-module configuration and executes bindex/register for each module.")
}

System_Ext(maven, "Apache Maven", "Build lifecycle, reactor, project model, settings, and plugin execution.")
System_Ext(actRuntime, "Machai Ghostwriter Act runtime", "Shared runtime that prepares Maven context, applies workflow configuration, and executes Acts.")
System_Ext(bindexActs, "Bindex Acts and registry", "Configured bindex and bindex/register workflows that generate or register Bindex metadata.")

Rel(developer, maven, "Invokes goal / configures")
Rel(maven, bindexMojo, "Executes bindex")
Rel(maven, bindexPerModuleMojo, "Executes bindex-per-module")
Rel(maven, registerMojo, "Executes register")
Rel(maven, registerPerModuleMojo, "Executes register-per-module")
Rel(registerMojo, bindexMojo, "Extends and inherits configuration")
Rel(registerPerModuleMojo, bindexPerModuleMojo, "Extends and inherits configuration")
Rel(bindexMojo, actRuntime, "Delegates bindex execution")
Rel(bindexPerModuleMojo, actRuntime, "Delegates bindex execution")
Rel(registerMojo, actRuntime, "Delegates bindex/register execution")
Rel(registerPerModuleMojo, actRuntime, "Delegates bindex/register execution")
Rel(actRuntime, bindexActs, "Prepares context and executes")

SHOW_LEGEND()
@enduml
